# ─── Local Docker Dev Environment ─────────────────────────────────────────────
# Copy this file to .env.local before running docker compose up.

# FastAPI backend URL (running in Docker on port 8000)
VITE_API_URL=http://localhost:8000

# Firebase/Identity Platform config (not needed for local dev, but required by SDK init)
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=madefor-seconds-local

# Dev-mode admin password — used by the local login modal
VITE_DEV_ADMIN_PASSWORD=changeme
