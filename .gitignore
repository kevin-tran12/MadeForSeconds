# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfstate.backup
# .terraform.lock.hcl is deliberately TRACKED — it pins provider versions so
# every machine and CI resolve identically. HashiCorp's own guidance is to commit it.
terraform/terraform.tfvars
terraform/.tmp/
# Plan files embed the fully resolved config, secrets included. Never commit one.
terraform/tfplan
terraform/*.tfplan
# The gcloud SDK was once unpacked here and committed; never again.
terraform/ls/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example

# Claude Code
CLAUDE.md
.claude/

# Personal job-search notes — must never reach the public repo
docs/RESUME_BULLETS.md
docs/OPS_BACKLOG.md

# Ad-hoc scratch output (rendered PDFs, screenshots). Nothing in the build reads this.
tmp/
