# ─── Backend Environment Variables ────────────────────────────────────────────

# GCP project ID
GCP_PROJECT_ID=madefor-seconds-local

# "development" or "production"
ENVIRONMENT=development

# Comma-separated list of admin email addresses
ADMIN_EMAILS=dev@local

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173

# Set by Docker Compose for local dev (points to Firestore emulator)
# FIRESTORE_EMULATOR_HOST=firestore-emulator:8080

# Redis URL for shared caching (optional — falls back to in-memory if unset)
# Local dev: set automatically by Docker Compose to redis://redis:6379
# Production: use Upstash free tier — https://upstash.com
# REDIS_URL=rediss://default:TOKEN@your-host.upstash.io:6379
