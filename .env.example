# ─── Production Environment Variables ─────────────────────────────────────────
# Set these in your CI/CD or hosting dashboard. Do NOT commit real values.

# Frontend (Vite — VITE_ prefix exposes to client)
VITE_API_URL=https://api.yourdomain.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-gcp-project-id
# Public status.json the budget breaker publishes/clears — confirms a
# deliberate cost-cap pause rather than a real outage. Bucket name matches
# module.storage.images_bucket_name ("${gcp_project_id}-images").
VITE_STATUS_URL=https://storage.googleapis.com/your-gcp-project-id-images/status.json

# Backend (FastAPI — server-side only)
GCP_PROJECT_ID=your-gcp-project-id
ENVIRONMENT=production
ADMIN_EMAILS=admin@yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com

# Sous Chef assistant (optional). Production authenticates to Anthropic with
# Workload Identity Federation — three ids, no key: Cloud Run's service account
# is the credential. All blank keeps the feature off. Production also requires
# REDIS_URL (the monthly spend cap lives in Redis). ANTHROPIC_API_KEY is for
# local development only and is refused in production.
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
# ANTHROPIC_WORKSPACE_ID=   # only when the rule spans more than one workspace
